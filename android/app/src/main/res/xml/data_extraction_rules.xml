<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same data to Google's cloud backup and to device transfer.
     Shared prefs (scheduled reminders) are left out on purpose: they are
     re-created from the database on first launch. -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="database" path="." />
    <include domain="file" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="." />
    <include domain="file" path="." />
  </device-transfer>
</data-extraction-rules>
