  </table>
        
  <div class="highlight">
    <div class="label">Balance due</div>
    <div class="highlight-value">£4,765.63</div>
  </div>
      </div>
    </div>

  
  <table class="items">
    <thead><tr><th class="desc">Description</th><th class="num">Qty</th><th class="num">Price</th><th class="num">Discount</th><th class="num">Tax</th><th class="num">Amount</th></tr></thead>
    <tbody>
    <tr>
      <td class="desc"><div class="item-name">Brand identity system</div><div class="item-desc">Logo suite, colour palette, typography and usage guidelines</div></td>
      <td class="num">1 project</td>
      <td class="num">£2,400.00</td>
