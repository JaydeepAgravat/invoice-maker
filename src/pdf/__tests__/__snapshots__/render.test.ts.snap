        <div class="label">Bill to</div>
        <div class="party-name">Harper &amp; Lane Architects</div>
        <div class="lines muted"><div>Amelia Hart</div><div>2 Granary Square</div><div>London N1C 4BH</div><div>accounts@harperlane.co</div><div>+44 7700 900123</div><div>VAT No. GB 987 6543 21</div></div>
      </div>
    
      <div class="party">
        <div class="label">Ship to</div>
