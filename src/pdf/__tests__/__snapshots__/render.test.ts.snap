    <div class="lines muted"><div>Northwind Studio Ltd</div><div>14 Chalk Farm Road</div><div>London NW1 8AB</div><div>United Kingdom</div><div>hello@northwind.studio</div><div>+44 20 7946 0321</div><div>northwind.studio</div><div>VAT No. GB 123 4567 89</div></div>
