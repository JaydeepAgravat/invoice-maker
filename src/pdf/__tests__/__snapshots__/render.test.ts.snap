      <tr><td class="nowrap">1 Aug 2026</td><td class="desc">Invoice INV-0001</td><td class="num">£1,800.00</td><td class="num"></td><td class="num amount">£1,800.00</td></tr><tr><td class="nowrap">1 Aug 2026</td><td class="desc">Invoice INV-0002</td><td class="num">£1,176.00</td><td class="num"></td><td class="num amount">£2,976.00</td></tr><tr><td class="nowrap">2 Sept 2026</td><td class="desc">Payment · INV-0001</td><td class="num"></td><td class="num">£750.00</td><td class="num amount">£2,226.00</td></tr><tr><td class="nowrap">2 Sept 2026</td><td class="desc">Payment · INV-0002</td><td class="num"></td><td class="num">£490.00</td><td class="num amount">£1,736.00</td></tr>
      <tr class="closing"><td></td><td class="desc">Closing balance</td><td></td><td></td><td class="num amount">£1,736.00</td></tr>
    </tbody>
  </table>
  <div class="block keep aging">
    <div class="label">Amount due by age</div>
    <table class="aging-table"><tr><th>Current</th><th>1–30 days</th><th>31–60 days</th><th>61–90 days</th><th>Over 90 days</th></tr>
    <tr><td>£0.00</td><td>£1,736.00</td><td>£0.00</td><td>£0.00</td><td>£0.00</td></tr></table>
  </div>
  
  
  
  
  <div class="block notes">
