      <td class="num amount">£1,275.00</td>
    </tr></tbody>
  </table>
  <div class="block keep totals-wrap">
  <table class="totals">
    <tr class=""><th>Subtotal</th><td>£6,411.00</td></tr><tr class=""><th>Discount 5%</th><td>−£320.55</td></tr><tr class=""><th>Courier</th><td>£18.00</td></tr><tr class=""><th>VAT 20%</th><td>£979.44</td></tr><tr class=""><th>VAT 5%</th><td>£60.56</td></tr><tr class="strong"><th>Total</th><td>£7,148.45</td></tr><tr class=""><th>Paid</th><td>−£2,382.82</td></tr><tr class="accent"><th>Balance due</th><td>£4,765.63</td></tr>
  </table></div>
  
  
  <div class="block keep payment">
    <div class="payment-body">
      <div class="label">How to pay</div>
      
        <div class="method">
          <div class="method-title">Bank transfer</div>
          <table class="kv"><tr><th>Account name</th><td>Northwind Studio Ltd</td></tr><tr><th>Sort code</th><td>04-00-04</td></tr><tr><th>Account number</th><td>12345678</td></tr><tr><th>IBAN</th><td>DE89 3704 0044 0532 0130 00</td></tr><tr><th>BIC / SWIFT</th><td>COBADEFFXXX</td></tr></table>
          
