        <h1>Statement of account </h1>
        <div class="number">ST-0001</div>
      </div>
    </header>
    
  <div class="subtitle">
    <div class="doc-title">Spring rebrand</div>
    
  </div>
    <div class="info">
      
  <div class="parties">
    
      <div class="party">
        <div class="label">Bill to</div>
        <div class="party-name">Harper &amp; Lane Architects</div>
        <div class="lines muted"><div>Amelia Hart</div><div>2 Granary Square</div><div>London N1C 4BH</div><div>accounts@harperlane.co</div><div>+44 7700 900123</div><div>VAT No. GB 987 6543 21</div></div>
      </div>
    
  </div>
      <div class="info-side">
        
  <table class="meta">
    <tr><th>Period</th><td>28 Jun 2026 – 26 Sept 2026</td></tr><tr><th>Date</th><td>26 Sept 2026</td></tr><tr><th>Supply date</th><td>26 Sept 2026</td></tr><tr><th>Reference</th><td>PO-20417</td></tr>
  </table>
        
  <div class="highlight">
